<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.akun.bridge.dpkgd</string>
	<key>Label</key>
	<string>com.akun.bridge.dpkgd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/akund</string>
		<string>--dpkgd</string>
		<string>19949</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardErrorPath</key>
	<string>/tmp/akun-dpkgd.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/akun-dpkgd-out.log</string>
</dict>
</plist>
